# ==============================================================================
# My Accounting — Environment Variables Template
# Copy to .env.local and fill in your values
# ==============================================================================

# Database (Postgres on Neon Serverless)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth / Session Secret
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email Service (Resend — https://resend.com/)
RESEND_API_KEY=
EMAIL_FROM="My Accounting <noreply@yourdomain.com>"

# Cloudflare R2 Storage (S3-compatible bucket for PDF attachments & receipt scans)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Background Jobs (Inngest — https://www.inngest.com/)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Payments (Stripe Test Mode — deferred/optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
